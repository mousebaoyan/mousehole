{
  "name": "mousehole",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && prettier --check . && pnpm test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:codegen": "kysely-codegen",
    "test": "vitest run",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hono/zod-openapi": "^1.6.3",
    "@react-router/node": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "hono": "^4.13.13",
    "isbot": "^5.2.2",
    "kysely": "^0.29.6",
    "lucide-react": "^1.55.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-router-hono-server": "^4.1.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@react-router/dev": "^8.4.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
