{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "promise", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true,
        "pathGroupOverrides": [
          {
            "pattern": "~/**",
            "action": "ignore"
          }
        ]
      }
    ],
    "import/no-cycle": "error",
    "no-alert": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["useMemo", "useCallback", "memo"],
            "message": "React Compiler memoizes automatically.",
            "allowTypeImports": true
          },
          {
            "name": "cn",
            "message": "Import cn from ~/cn, which knows the theme's font sizes."
          }
        ]
      }
    ],
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": true,
        "ts-ignore": true,
        "ts-nocheck": true
      }
    ],
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "package": "react-router",
            "name": "DataWithResponseInit"
          }
        ]
      }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    // They want toSorted() and toReversed(), which the oldest browsers we support lack
    // (development.md §4).
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "react/react-in-jsx-scope": "off"
  },
  // The layers of docs/development.md §1.2. An override replaces the rule's options, so each one
  // repeats the paths above.
  "overrides": [
    {
      "files": ["app/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useMemo", "useCallback", "memo"],
                "message": "React Compiler memoizes automatically.",
                "allowTypeImports": true
              },
              {
                "name": "cn",
                "message": "Import cn from ~/cn, which knows the theme's font sizes."
              },
              {
                "name": "kysely",
                "message": "Pages call /api/v1 and don't query the database."
              }
            ],
            "patterns": [
              {
                "group": [
                  "**/server/modules/**",
                  "!**/server/modules/coins/rules.ts",
                  "!**/server/modules/levels/rules.ts",
                  "!**/server/modules/sponsors/rules.ts",
                  "!**/server/modules/threads/merge-rules.ts",
                  "!**/server/modules/users/customization.ts",
                  "!**/server/modules/notifications/types.ts",
                  "!**/server/modules/auth/routes.ts",
                  "**/platform/db.ts"
                ],
                "message": "Pages call /api/v1; of the modules they import only rules and types."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["server/platform/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useMemo", "useCallback", "memo"],
                "message": "React Compiler memoizes automatically.",
                "allowTypeImports": true
              },
              {
                "name": "cn",
                "message": "Import cn from ~/cn, which knows the theme's font sizes."
              }
            ],
            "patterns": [
              {
                "group": ["**/modules/**"],
                "message": "platform depends on no business module."
              }
            ]
          }
        ]
      }
    }
  ]
}
